{
  "name": "deep-throne-chronicles",
  "version": "0.1.0",
  "private": true,
  "description": "Хроники Глубинного Трона — уютная тёмная пиксельная RPG о подземелье под городом Вальмарк",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:single": "vite build --mode single",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "node e2e/smoke.mjs",
    "artifact": "vite build --mode single && node scripts/artifact.mjs",
    "balance": "tsx scripts/balance.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "playwright-core": "^1.63.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "@colyseus/core": "^0.16.26",
    "@colyseus/schema": "^3.0.76",
    "@colyseus/ws-transport": "^0.16.5",
    "@fontsource/pixelify-sans": "^5.3.0",
    "@fontsource/press-start-2p": "^5.3.0",
    "colyseus.js": "^0.16.22"
  }
}
